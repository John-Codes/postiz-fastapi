# Copy to .env and fill in. .env is gitignored; never commit real values.

# Base URL of the Postiz public API. The official compose maps the Postiz
# container to 127.0.0.1:4007, and the public API lives under /api/public/v1.
POSTIZ_API_URL=http://127.0.0.1:4007/api/public/v1

# Postiz API key: Postiz UI -> Settings -> Developers -> API Keys.
# Sent as the raw Authorization header value, with no "Bearer" prefix.
POSTIZ_API_KEY=

# Per-request timeout for calls to Postiz.
POSTIZ_TIMEOUT_SECONDS=10

# FastAPI binds to loopback by default. Tailscale provides remote access.
FASTAPI_HOST=127.0.0.1
FASTAPI_PORT=8000
